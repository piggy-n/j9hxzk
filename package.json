{
  "name": "j9hxzk",
  "private": true,
  "license": "ISC",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "dev": "turbo run dev",
    "dev:one-map-web": "turbo run dev --filter=one-map-web",
    "fix": "pnpm sort:json && eslint . --fix && prettier . --write",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "preview": "turbo run preview",
    "preview:one-map-web": "turbo run preview --filter=one-map-web",
    "sort:json": "node sort-json.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,html,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-vue": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vue-eslint-parser": "^10.4.0"
  }
}
